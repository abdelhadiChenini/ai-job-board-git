// Prisma schema for AI Job Board
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model JobOffer {
  id              String     @id @default(uuid())
  slug            String?    @unique
  title           String
  description     String     @db.Text
  aiLabName       String
  badge           String?
  salaryMin       Int?
  salaryMax       Int?
  currency        String     @default("USD")
  tags            Json
  affiliateUrl    String     @map("affiliate_url")
  clickCount      Int        @default(0) @map("click_count")
  datePosted      DateTime?  @map("date_posted")
  jobLocationType String     @default("Remote") @map("job_location_type")
  category        String?
  region          String?

  platform   AIPlatform @relation(fields: [platformId], references: [id])
  platformId String     @map("platform_id")

  savedBy   SavedOpportunity[]
  appliedBy AppliedOpportunity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([platformId])
  @@map("job_offers")
}

model SavedOpportunity {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  opportunityId String    @map("opportunity_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity JobOffer @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([opportunityId])
  @@map("saved_opportunities")
}

model AppliedOpportunity {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  opportunityId String    @map("opportunity_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity JobOffer @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([opportunityId])
  @@map("applied_opportunities")
}

model AIPlatform {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  websiteUrl String?    @map("website_url")
  description String?   @db.Text
  logoUrl    String?    @db.LongText @map("logo_url")

  jobOffers JobOffer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_platforms")
}

model Expert {
  id          String   @id @default(uuid())
  name        String
  title       String?  // e.g. "Ex-OpenAI Research Scientist"
  bio         String?  @db.Text
  skills      Json
  email       String?  @unique
  twitterUrl  String?  @map("twitter_url")
  linkedinUrl String?  @map("linkedin_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("experts")
}

enum UserRole {
  ADMIN
  EXPERT
}

enum VerificationStatus {
  PENDING
  VERIFIED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  role           UserRole @default(EXPERT)
  lastAIGeneration DateTime? @map("last_ai_generation")

  blogPosts    BlogPost[]
  expertProfile ExpertProfile?
  savedOpportunities   SavedOpportunity[]
  appliedOpportunities AppliedOpportunity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ExpertProfile {
  id                String             @id @default(uuid())
  fullName          String             @map("full_name")
  profilePicture    String?            @db.LongText @map("profile_picture")
  headline          String?
  country           String?
  skills            Json               @default("[]")
  isPublic          Boolean            @default(false) @map("is_public")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  bio               String?  @db.Text
  stateRegion       String?  @map("state_region")
  areasOfExpertise  String?  @map("areas_of_expertise")
  languages         String?
  yearsOfExperience String?  @map("years_of_experience")
  availability      String?
  workPreference    String?  @map("work_preference")
  hourlyRate        String?  @map("hourly_rate")
  education         String?  @db.Text
  certifications    String?  @db.Text
  linkedin          String?
  xUrl              String?  @map("x_url")
  github            String?
  youtube           String?
  website           String?
  phoneNumber       String?  @map("phone_number")
  showEmail         Boolean  @default(false) @map("show_email")
  showPhone         Boolean  @default(false) @map("show_phone")
  emailUpdates      Boolean  @default(true) @map("email_updates")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublic])
  @@map("expert_profiles")
}

model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  featuredImage   String?  @db.LongText @map("featured_image")
  metaDescription String   @map("meta_description")
  excerpt         String   @db.Text
  published       Boolean  @default(false)
  publishedAt     DateTime? @map("published_at")

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([authorId])
  @@map("blog_posts")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model SeoSetting {
  id              String   @id @default("global")
  siteTitle       String?  @map("site_title")
  metaDescription String?  @db.Text @map("meta_description")
  keywords        String?  @db.Text
  logoUrl         String?  @db.LongText @map("logo_url")
  headerInjection String?  @db.Text @map("header_injection")
  bodyInjection   String?  @db.Text @map("body_injection")
  footerInjection String?  @db.Text @map("footer_injection")
  linkedinUrl     String?  @map("linkedin_url")
  twitterUrl      String?  @map("twitter_url")
  instagramUrl    String?  @map("instagram_url")
  youtubeUrl      String?  @map("youtube_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seo_settings")
}

model Page {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  content String @db.LongText

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique

  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

model SMTPSettings {
  id        String  @id @default("default")
  host      String
  port      Int
  user      String
  pass      String
  fromEmail String  @map("from_email")
  fromName  String  @map("from_name")

  @@map("smtp_settings")
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String? @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Region {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("regions")
}