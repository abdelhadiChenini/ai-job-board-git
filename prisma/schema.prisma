// Prisma schema for AI Job Board
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model JobOffer {
  id              String     @id @default(uuid())
  slug            String?    @unique
  title           String
  description     String     @db.Text
  aiLabName       String
  salaryMin       Int?
  salaryMax       Int?
  currency        String     @default("USD")
  tags            Json
  affiliateUrl    String     @map("affiliate_url")
  datePosted      DateTime?  @map("date_posted")
  jobLocationType String     @default("Remote") @map("job_location_type")

  platform   AIPlatform @relation(fields: [platformId], references: [id])
  platformId String     @map("platform_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([platformId])
  @@map("job_offers")
}

model AIPlatform {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  websiteUrl String?    @map("website_url")
  description String?   @db.Text

  jobOffers JobOffer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_platforms")
}

model Expert {
  id          String   @id @default(uuid())
  name        String
  title       String?  // e.g. "Ex-OpenAI Research Scientist"
  bio         String?  @db.Text
  skills      Json
  email       String?  @unique
  twitterUrl  String?  @map("twitter_url")
  linkedinUrl String?  @map("linkedin_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("experts")
}

enum UserRole {
  ADMIN
  EXPERT
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  role           UserRole @default(EXPERT)

  blogPosts    BlogPost[]
  expertProfile ExpertProfile?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ExpertProfile {
  id                String   @id @default(uuid())
  fullName          String   @map("full_name")
  profilePicture    String?  @db.LongText @map("profile_picture")
  headline          String?
  country           String?
  skills            Json     @default("[]")
  isPublic          Boolean  @default(false) @map("is_public")
  bio               String?  @db.Text
  stateRegion       String?  @map("state_region")
  areasOfExpertise  String?  @map("areas_of_expertise")
  languages         String?
  yearsOfExperience String?  @map("years_of_experience")
  availability      String?
  workPreference    String?  @map("work_preference")
  hourlyRate        String?  @map("hourly_rate")
  education         String?  @db.Text
  certifications    String?  @db.Text
  linkedin          String?
  xUrl              String?  @map("x_url")
  github            String?
  youtube           String?
  website           String?
  phoneNumber       String?  @map("phone_number")
  showEmail         Boolean  @default(false) @map("show_email")
  showPhone         Boolean  @default(false) @map("show_phone")
  emailUpdates      Boolean  @default(true) @map("email_updates")

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublic])
  @@map("expert_profiles")
}

model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  metaDescription String   @map("meta_description")
  excerpt         String   @db.Text
  published       Boolean  @default(false)
  publishedAt     DateTime? @map("published_at")

  author   User   @relation(fields: [authorId], references: [id])
  authorId String @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([authorId])
  @@map("blog_posts")
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Page {
  id      String @id @default(uuid())
  slug    String @unique
  title   String
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}