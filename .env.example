# Database
DATABASE_URL="mysql://user:password@host:3306/database"

# NextAuth
NEXTAUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public site origin, used to build PayPal return/cancel URLs server-side.
# Must match the deployed origin with no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PayPal — https://developer.paypal.com/dashboard/applications
# There is no environment switch: the server always calls the live API at
# https://api-m.paypal.com, so use live credentials and a live plan id here.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# ID of the PayPal plan that grants PRO access (Products & Services > Plans).
PAYPAL_PLAN_ID=""
# Accepted aliases, for hosts that already use these names. The names above win
# when both are set, so these are only a fallback:
#   PAYPAL_CLIENT_SECRET  <- PAYPAL_SECRET
#   PAYPAL_PLAN_ID        <- NEXT_PUBLIC_PAYPAL_PLAN_ID
# ID of the webhook subscribed to BILLING.SUBSCRIPTION.* events. Required for
# signature verification — without it every webhook is rejected.
PAYPAL_WEBHOOK_ID=""
# Client ID is public by design: the browser loads PayPal's SDK with it. Exposed
# to the client bundle at build time, so changing it needs a redeploy.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# OpenAI — https://platform.openai.com/api-keys
# Server-only. Powers the Pro AI CV Builder: model-generated CV content only,
# never sent to the browser. Without it the endpoint answers 503 rather than
# failing mid-generation.
OPENAI_API_KEY=""

# Shared secret for the scheduled reconciliation sweep
# (.github/workflows/reconcile.yml). Set the same value as the GitHub secret
# RECONCILIATION_SECRET. Leave empty and the endpoint rejects every
# non-session caller, which disables the cron rather than exposing it.
RECONCILIATION_SECRET=""

# Resend — https://resend.com/api-keys
# Used only by the admin bulk re-engagement campaign. This is separate from the
# SMTP transport in lib/mailer.ts, which still handles transactional mail.
RESEND_API_KEY=""
# Verified sending address on a domain confirmed in the Resend dashboard.
# Required: Resend rejects any sender on an unverified domain.
RESEND_FROM_EMAIL="Acme <hello@example.com>"
