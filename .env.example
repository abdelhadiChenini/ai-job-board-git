# Database
DATABASE_URL="mysql://user:password@host:3306/database"

# NextAuth
NEXTAUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# PayPal — https://developer.paypal.com/dashboard/applications
# Only "sandbox" or "live". Anything else is treated as sandbox, so a
# half-configured deploy can never take live payments.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# ID of the PayPal plan that grants PRO access (Products & Services > Plans).
PAYPAL_PLAN_ID=""
# ID of the webhook subscribed to BILLING.SUBSCRIPTION.* events. Required for
# signature verification — without it every webhook is rejected.
PAYPAL_WEBHOOK_ID=""
